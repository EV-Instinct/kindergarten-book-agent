# Streamlit 密钥配置模板
# 使用方法：复制本文件为 .streamlit/secrets.toml 并填入真实值（该文件已被 .gitignore 排除，不会提交）
# 云端部署时，在 Streamlit Community Cloud 的 Secrets 设置中填入同样的键值

# 教师管理安全 PIN 码
TEACHER_PIN = "123456"

# Google Gemini API（语音识别 / 智能对话 / AI 建档）
GEMINI_API_KEY = ""

# DeepSeek API（国产大模型，赛事申报推荐）
DEEPSEEK_API_KEY = ""
DEEPSEEK_BASE_URL = "https://api.deepseek.com/v1"
DEEPSEEK_MODEL = "deepseek-chat"

# 阿里云百炼 API（推荐：LLM 对话 + Qwen3-TTS 语音合成 共用同一 Key）
# 换 Key 时只改这里，不要动 .py 代码
BAILIAN_API_KEY = ""
BAILIAN_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
BAILIAN_MODEL = "qwen3.5-flash"
